cabal-version:      3.12
name:               tender
version:            0.1.0.0
synopsis:           Swipe on restaurants with friends until you agree on one
author:             Gavin Jaeger-Freeborn
maintainer:         gavinfreeborn@gmail.com
extra-source-files: CHANGELOG.md

common shared
    default-language:   GHC2024
    default-extensions: OverloadedStrings
    ghc-options:        -Wall -Wcompat -Widentities -Wredundant-constraints -Wunused-packages -Wmissing-deriving-strategies
    build-depends:      base ^>=4.21.0.0

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  App, Db, Fetch, Limits, Log, OpenStreetMap, Places, Provider, Restaurant, User, Vibe, Yelp
    build-depends:    aeson         >=2.1   && <2.3
                    , bytestring    >=0.11  && <0.13
                    , http-conduit  >=2.3   && <2.4
                    , http-client   >=0.7.13 && <0.8
                    , containers    >=0.6   && <0.9
                    , time          >=1.12  && <1.16
                    , http-types    >=0.12  && <0.13
                    , scotty        >=0.22  && <0.31
                    , sqlite-simple >=0.4.18 && <0.5
                    , text          >=1.2.5 && <2.2
                    , uuid          >=1.3.15 && <1.4
                    , wai-extra     >=3.1   && <3.2
                    , wai           >=3.2   && <3.3
                    , directory     >=1.3   && <1.4
                    , filepath      >=1.4   && <1.6
                    , resource-pool >=0.4   && <0.6
                    , mime-types    >=0.1   && <0.2

executable tender
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    -- Warp, request timeouts and the cleanup thread need the threaded runtime
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    tender

test-suite spec
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Endpoints
    build-depends:    tender
                    , hspec-wai
                    , wai
                    , wai-extra
                    , http-types
                    , directory
                    , filepath
                    , aeson
                    , hspec         >=2.10  && <2.12
                    , http-conduit
                    , containers
                    , time
                    , bytestring
                    , text
                    , sqlite-simple
