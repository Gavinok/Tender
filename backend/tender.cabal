cabal-version:      2.4
name:               tender
version:            0.1.0.0
synopsis:           Swipe on restaurants with friends until you agree on one
author:             Gavin Jaeger-Freeborn
maintainer:         gavinfreeborn@gmail.com
extra-source-files: CHANGELOG.md

common shared
    default-language:   Haskell2010
    default-extensions: OverloadedStrings
    ghc-options:        -Wall
    build-depends:      base ^>=4.17.0.0

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:  App, Db, Fetch, OpenStreetMap, Places, Provider, Restaurant, User, Vibe, Yelp
    build-depends:    aeson         >=2.1   && <2.3
                    , bytestring    >=0.11  && <0.13
                    , http-conduit  >=2.3   && <2.4
                    , http-client   >=0.7.13 && <0.8
                    , containers    >=0.6   && <0.7
                    , http-types    >=0.12  && <0.13
                    , scotty        >=0.20  && <0.23
                    , sqlite-simple >=0.4.18 && <0.5
                    , text          >=1.2.5 && <2.2
                    , uuid          >=1.3.15 && <1.4
                    , wai-cors      >=0.2.7 && <0.3
                    , wai-extra     >=3.1   && <3.2
                    , wai           >=3.2   && <3.3
                    , directory     >=1.3   && <1.4
                    , filepath      >=1.4   && <1.5

executable tender
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    tender

test-suite spec
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    tender
                    , aeson
                    , hspec         >=2.10  && <2.12
                    , http-conduit
                    , bytestring
                    , text
                    , sqlite-simple
